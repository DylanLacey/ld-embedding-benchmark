{
  "name": "embedding4ld",
  "version": "1.0.0",
  "description": "AI-enhanced text search exploration with Hugging Face",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "embedding4ld": "./dist/cli.js"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "scrape": "tsx src/scraper.ts",
    "migrate:neon": "tsx src/migrate-to-neon.ts",
    "seed:queries": "tsx src/seed-queries.ts",
    "test:e2e": "tsx src/test-e2e.ts",
    "admin": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "admin:test": "pnpm --filter admin test",
    "admin:lint": "pnpm --filter admin lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "lefthook": "^2.0.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.10",
    "@neondatabase/serverless": "^1.0.2",
    "better-sqlite3": "^12.6.2",
    "c12": "^3.3.3",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "execa": "^9.6.1",
    "listr2": "^10.1.0",
    "ora": "^9.1.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
